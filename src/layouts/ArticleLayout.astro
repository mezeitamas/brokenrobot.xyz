---
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '@layouts/BaseLayout.astro';

import MetaOgArticle from '@components/seo/meta-og/MetaOgArticle.astro';
import MetaTwitter from '@components/seo/meta-twitter/MetaTwitter.astro';
import RichResultsArticle from '@components/seo/rich-results/RichResultsArticle.astro';

import { markdownTwinPath } from '@utils/markdownTwin';

// The `seo` slot carries the pair the llms.txt convention recommends, beside the RSS `alternate`
// link BaseLayout already emits: `alternate` names this page's Markdown twin, and `describedby`
// names the index covering the rest, so an agent landing on one post can reach the others. Neither
// relation fetches anything, so neither touches the CSP.

type Props = CollectionEntry<'blog'>['data'] & {
    // The post's id, which its frontmatter does not carry — the layout needs it to name the twin.
    postId: string;
};

const { postId, title, excerpt, publishDate, heroImage, tags } = Astro.props;
---

<BaseLayout
    pageTitle={title}
    pageDescription={excerpt}
>
    <Fragment slot="seo">
        <meta
            name="keywords"
            content={tags?.join(', ')}
        />

        <link
            rel="alternate"
            type="text/markdown"
            href={markdownTwinPath(postId)}
        />

        <link
            rel="describedby"
            href="/llms.txt"
        />

        <MetaOgArticle
            title={title}
            description={excerpt}
            image={heroImage.src}
            publishDate={publishDate}
            tags={tags}
        />

        <MetaTwitter
            title={title}
            description={excerpt}
            image={heroImage.src}
        />

        <RichResultsArticle
            title={title}
            description={excerpt}
            image={heroImage.src}
            publishDate={publishDate}
            tags={tags}
        />
    </Fragment>

    <slot
        name="content"
        slot="content"
    />
</BaseLayout>
