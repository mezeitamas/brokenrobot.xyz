---
import { Picture } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ArticleLayout from '@layouts/ArticleLayout.astro';

import PublishDate from '@components/blog-posts/PublishDate.astro';
import ReadingTime from '@components/blog-posts/ReadingTime.astro';
import TldrLink from '@components/blog-posts/TldrLink.astro';

import { minutesReadCountOf } from '@utils/minutesReadCountOf';
import { getPostsWithTldrs } from '@utils/tldr';
import { tldrPagePath } from '@utils/markdownTwin';

export async function getStaticPaths() {
    const posts = await getCollection('blog');

    return posts.map((post) => ({
        params: { slug: post.id },
        props: post
    }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const {
    data: { title, excerpt, publishDate, heroImage, tags }
} = post;

const tldr = (await getPostsWithTldrs()).get(post.id);
const tldrMinutes = tldr === undefined ? undefined : minutesReadCountOf((await render(tldr)).remarkPluginFrontmatter);
---

<ArticleLayout
    postId={post.id}
    title={title}
    excerpt={excerpt}
    publishDate={publishDate}
    heroImage={heroImage}
    tags={tags}
>
    <Fragment slot="content">
        <article>
            <header>
                <h1>{title}</h1>

                <div class="flex flex-col sm:flex-row sm:gap-8">
                    <PublishDate date={publishDate} />

                    <ReadingTime minutesRead={remarkPluginFrontmatter.minutesRead} />

                    {
                        tldrMinutes !== undefined && (
                            <TldrLink
                                href={tldrPagePath(post.id)}
                                minutes={tldrMinutes}
                            />
                        )
                    }
                </div>
            </header>

            <section>
                <Picture
                    src={heroImage}
                    alt={title}
                    layout="full-width"
                    priority
                    pictureAttributes={{
                        class: 'not-prose rounded-lg'
                    }}
                    class="not-prose rounded-lg"
                />

                <Content />
            </section>
        </article>
    </Fragment>
</ArticleLayout>
