{
    "mcpServers": {
        "astro-docs": {
            "type": "http",
            "url": "https://mcp.docs.astro.build/mcp"
        },
        "codegraph": {
            "command": "codegraph",
            "args": ["serve", "--mcp"]
        },
        "terraform": {
            "command": "docker",
            "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:1.3.0", "--toolsets=registry"]
        },
        "github": {
            "command": "docker",
            "args": [
                "run",
                "-i",
                "--rm",
                "--env-file",
                ".env.github-mcp",
                "-e",
                "GITHUB_READ_ONLY=1",
                "-e",
                "GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions",
                "ghcr.io/github/github-mcp-server:v1.14.0"
            ]
        }
    }
}
