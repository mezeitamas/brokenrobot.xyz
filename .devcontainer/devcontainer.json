{
    "name": "brokenrobot.xyz",
    // The same image, by the same digest, as every job in .github/workflows/pipeline.yml — the
    // visual baselines must render in one environment locally and in CI. Change both together.
    "image": "ghcr.io/jdx/mise:2026.10.9-debian@sha256:2e59c25cb3b4c54ff2769d7a00b48ec41e8e07211c2823247b714a2c231ac615",
    // A login shell's /etc/profile resets PATH and drops the image's mise shims; this restores them
    // for everything the devcontainer runs.
    "remoteEnv": {
        "PATH": "/mise/shims:${containerEnv:PATH}"
    },
    "mounts": [
        "source=${localWorkspaceFolderBasename}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
    ],
    "postCreateCommand": "mise install --locked && npm install && npm run install:playwright",
    "customizations": {
        "vscode": {
            "settings": {},
            "extensions": [
                "EditorConfig.EditorConfig",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "astro-build.astro-vscode",
                "bradlc.vscode-tailwindcss",
                "hashicorp.terraform",
                "redhat.vscode-yaml",
                "ms-playwright.playwright",
                "unifiedjs.vscode-mdx"
            ]
        }
    }
}
